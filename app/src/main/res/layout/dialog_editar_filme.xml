<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="100dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Foto do filme"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_filme" />

    <EditText
        android:id="@+id/edt_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nome do filme"
        android:inputType="text" />

    <EditText
        android:id="@+id/edt_nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nota (0 a 10)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/edt_foto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Link da foto (URL)"
        android:inputType="textUri" />

    <Button
        android:id="@+id/btn_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="Ver foto" />

</LinearLayout>
